# -*- coding: utf-8 -*-
"""
assistant.py — расширенный «мозг» для Coffee Bot.
Теперь умеет:
- Перевод / анти-кликбейт / фан-редактура / саммари
- Форматирование дайджестов и источников
- Классификация тем и хэштеги
- Breaking → Digest
- Фильтрация «нереалевских» новостей
- Оценка важности новости
- Генерация коротких алертов
- Проверка на смысловые дубли

Дополнительно:
- Прямая работа с OpenAI через локальный HTTP-прокси (VLESS Reality → sing-box)
- Ретраи на 429/5xx, понятные ошибки, конфиг через ENV
"""

from __future__ import annotations
import os
import time
import json
import logging
from typing import List, Dict, Optional

import httpx
from openai import OpenAI
from openai._exceptions import (
    APIStatusError, APIConnectionError, APITimeoutError, RateLimitError
)

logger = logging.getLogger("assistant")
if not logger.handlers:
    h = logging.StreamHandler()
    h.setFormatter(logging.Formatter("[%(asctime)s] %(levelname)s assistant: %(message)s"))
    logger.addHandler(h)
logger.setLevel(logging.INFO)

# ===== Конфиг через ENV =====
DEFAULT_MODEL = os.getenv("OPENAI_MODEL", "gpt-5")
MAX_RETRIES = int(os.getenv("OPENAI_RETRIES", "4"))
# Таймаут в секундах для HTTP-клиента OpenAI
TIMEOUT = float(os.getenv("OPENAI_TIMEOUT", "30"))

OPENAI_API_KEY = os.getenv("OPENAI_API_KEY", "")
OPENAI_API_BASE = os.getenv("OPENAI_API_BASE", "https://api.openai.com/v1")

# Локальный прокси от sing-box (VLESS Reality). Можно переопределить через ENV.
HTTP_PROXY = os.getenv("HTTP_PROXY", "http://127.0.0.1:8080")
HTTPS_PROXY = os.getenv("HTTPS_PROXY", "http://127.0.0.1:8080")

# Если хочешь полностью выключить прокси — задай обе переменные пустыми строками.
PROXIES: Optional[dict] = None
if HTTP_PROXY or HTTPS_PROXY:
    PROXIES = {
        "http://": HTTP_PROXY,
        "https://": HTTPS_PROXY,
    }

SYSTEM_NEWS = (
    "Ты редактор новостного канала болельщиков Реала Мадрид «Кофе со сливками». "
    "Пиши на русском, чётко и без кликбейта. Сохраняй атмосферу клуба."
)

SYSTEM_FAN = (
    "Ты автор фанатских текстов для паблика болельщиков Реала Мадрид. "
    "Пиши эмоционально, атмосферно, с отсылками к Бернабеу и королевскому наследию."
)

def _make_openai_client() -> OpenAI:
    """
    Создаёт OpenAI-клиент с httpx и прокси.
    Совместимо с httpx, где нет параметра proxies в Client.__init__.
    """
    if not OPENAI_API_KEY:
        raise RuntimeError("OPENAI_API_KEY не задан")

    # Берём прокси из ENV (HTTPS_PROXY приоритетнее)
    proxy = os.getenv("HTTPS_PROXY") or os.getenv("HTTP_PROXY")

    # Транспорт с прокси (если есть)
    transport = httpx.HTTPTransport(proxy=proxy) if proxy else httpx.HTTPTransport()

    # Важно: прокси задаём через transport, а не через Client(proxies=...)
    http_client = httpx.Client(
        timeout=TIMEOUT,
        transport=transport,
        headers={"User-Agent": "coffee-bot-assistant/1.0"},
    )

    client = OpenAI(
        api_key=OPENAI_API_KEY,
        base_url=OPENAI_API_BASE.rstrip("/"),
        http_client=http_client,
    )
    return client
class Assistant:
    def __init__(self, model: str = DEFAULT_MODEL, temperature: float = 0.2):
        self.client = _make_openai_client()
        self.model = model
        self.temperature = temperature

    def _call(self, messages: List[Dict[str, str]], max_tokens: int = 800) -> str:
        """
        Унифицированный вызов Responses API с ретраями.
        """
        err: Optional[Exception] = None
        for attempt in range(1, MAX_RETRIES + 1):
            try:
                # Создаём «тонкого» клиента с нужным таймаутом на каждый вызов (опционально)
                with self.client.responses.with_options(timeout=TIMEOUT) as rcli:
                    r = rcli.create(
                        model=self.model,
                        input=messages,
                        temperature=self.temperature,
                        max_output_tokens=max_tokens,
                    )

                # Нормализация ответа для разных форматов SDK
                if getattr(r, "output_text", None):
                    text = (r.output_text or "").strip()
                    if text:
                        return text

                # Фоллбек: вытаскиваем контент по частям
                output = getattr(r, "output", None) or []
                for item in output:
                    if getattr(item, "type", "") == "message":
                        for c in getattr(item, "content", []) or []:
                            if getattr(c, "type", "") == "output_text":
                                text = (getattr(c, "text", "") or "").strip()
                                if text:
                                    return text

                raise RuntimeError("Empty response")
            except (RateLimitError, APIStatusError, APIConnectionError, APITimeoutError) as e:
                err = e
                # Детекция гео-блокировки
                emsg = str(e)
                if "unsupported_country_region_territory" in emsg.lower():
                    logger.error(
                        "OpenAI блокирует по региону (unsupported_country_region_territory). "
                        "Убедись, что запрос идёт через VLESS-прокси (sing-box) и прокси переменные заданы корректно: "
                        "HTTP_PROXY/HTTPS_PROXY=%s/%s",
                        HTTP_PROXY, HTTPS_PROXY
                    )
                if attempt < MAX_RETRIES:
                    sleep_s = 1.25 * attempt
                    logger.warning("Retry %d/%d после ошибки: %s (sleep %.1fs)", attempt, MAX_RETRIES, e, sleep_s)
                    time.sleep(sleep_s)
                    continue
            except Exception as e:
                err = e
                if attempt < MAX_RETRIES:
                    sleep_s = 1.25 * attempt
                    logger.warning("Retry %d/%d: %s (sleep %.1fs)", attempt, MAX_RETRIES, e, sleep_s)
                    time.sleep(sleep_s)
                    continue
            break
        raise RuntimeError(f"OpenAI error: {err}")

    def ask(self, prompt: str, system: Optional[str] = None, max_tokens: int = 800) -> str:
        sys = {"role": "system", "content": system or SYSTEM_NEWS}
        usr = {"role": "user", "content": prompt}
        return self._call([sys, usr], max_tokens=max_tokens)

    # --- базовые ---
    def translate_news(self, text: str) -> str:
        return self.ask(f"Переведи и отредактируй под канал:\n\n{text}")

    def debaitify(self, text: str) -> str:
        return self.ask(f"Убери кликбейт, перепиши коротко и ясно:\n\n{text}")

    def fan_rewrite(self, text: str, intensity: str = "balanced") -> str:
        tone = {
            "soft": "мягко, благородно",
            "balanced": "эмоционально, но сдержанно",
            "hype": "ярко, дерзко",
        }.get(intensity, "balanced")
        return self.ask(f"Перепиши в фанатском стиле ({tone}):\n\n{text}", system=SYSTEM_FAN)

    def summarize_news(self, text: str, bullets: int = 3) -> str:
        return self.ask(f"Сделай краткий конспект {bullets} пунктами:\n{text}")

    # --- продвинутые ---
    def format_digest(self, items: List[Dict]) -> str:
        text = "\n".join([
            f"{i+1}️⃣ {x['title']}\n🔗 {x['link']}\nИсточник: {x['source']}\n━━━━━━━━━━━━━━"
            for i, x in enumerate(items)
        ])
        return f"☕ Сливочный дайджест\n\n{text}"

    def format_source(self, source: str) -> str:
        return self.ask(f"Сделай короткую подпись источника (например, 'Marca сообщает'):\n{source}")

    def classify_news(self, text: str) -> str:
        return self.ask("Определи тему одним словом: трансферы, матчи, травмы, титулы, другое.\n\n{text}")

    def generate_hashtags(self, text: str, limit: int = 3) -> str:
        return self.ask(f"Сгенерируй до {limit} хэштегов латиницей (про Реал и тему текста):\n{text}")

    def breaking_to_digest(self, text: str) -> str:
        return self.ask(f"Перепиши breaking-новость в спокойный дайджест-формат:\n\n{text}")

    def filter_non_real(self, text: str) -> Optional[str]:
        verdict = self.ask("Это новость про Реал Мадрид? Ответь только 'да' или 'нет'.\n\n" + text)
        return text if verdict.strip().lower().startswith("д") else None

    # --- новые ---
    def importance_score(self, text: str) -> str:
        return self.ask("Оцени важность новости одним словом: высокая, средняя, низкая.\n\n{text}")

    def generate_alert(self, text: str) -> str:
        return self.ask(
            "Сделай короткий алерт для push (до 100 символов, факт+эмоция):\n" + text,
            max_tokens=60
        )

    def is_duplicate_meaning(self, text1: str, text2: str) -> bool:
        verdict = self.ask(
            "Эти два текста описывают одну и ту же новость? Ответь только 'да' или 'нет'.\n\n1) "
            + text1 + "\n\n2) " + text2
        )
        return verdict.strip().lower().startswith("д")

# глобальный синглтон
_client: Optional[Assistant] = None
def get_client() -> Assistant:
    global _client
    if _client is None:
        _client = Assistant()
    return _client

# фасады
def translate_news(text: str) -> str: return get_client().translate_news(text)
def debaitify(text: str) -> str: return get_client().debaitify(text)
def fan_rewrite(text: str, **kwargs) -> str: return get_client().fan_rewrite(text, **kwargs)
def summarize_news(text: str, **kwargs) -> str: return get_client().summarize_news(text, **kwargs)
def format_digest(items: List[Dict]) -> str: return get_client().format_digest(items)
def format_source(source: str) -> str: return get_client().format_source(source)
def classify_news(text: str) -> str: return get_client().classify_news(text)
def generate_hashtags(text: str, **kwargs) -> str: return get_client().generate_hashtags(text, **kwargs)
def breaking_to_digest(text: str) -> str: return get_client().breaking_to_digest(text)
def filter_non_real(text: str) -> Optional[str]: return get_client().filter_non_real(text)
def importance_score(text: str) -> str: return get_client().importance_score(text)
def generate_alert(text: str) -> str: return get_client().generate_alert(text)
def is_duplicate_meaning(t1: str, t2: str) -> bool: return get_client().is_duplicate_meaning(t1, t2)

if __name__ == "__main__":
    demo1 = "Real Madrid готов продать Винисиуса Жуниора из-за контракта."
    demo2 = "Реал Мадрид рассматривает продажу Винисиуса из-за требований по контракту."
    print("Перевод:", translate_news("Real Madrid are ready to sell Vinicius Jr."))
    print("Важность:", importance_score(demo1))
    print("Алерт:", generate_alert(demo1))
    print("Дубль?:", is_duplicate_meaning(demo1, demo2))
