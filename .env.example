TELEGRAM_BOT_TOKEN=123456789:replace_me
TARGET_CHAT_ID=@your_channel_username

# Safe by default: prints messages instead of sending them to Telegram.
DRY_RUN=true

# Optional: recommended paid translator for better Russian news text.
# Create an API key with yc.ai.translate.execute scope and set the folder id.
YANDEX_TRANSLATE_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_TRANSLATE_URL=https://translate.api.cloud.yandex.net/translate/v2/translate

# Optional budget-capped YandexGPT editor.
# It reuses YANDEX_TRANSLATE_API_KEY/YANDEX_FOLDER_ID unless the LLM fields are set.
YANDEX_LLM_ENABLED=false
YANDEX_LLM_API_KEY=
YANDEX_LLM_FOLDER_ID=
YANDEX_LLM_MODEL=yandexgpt-lite
YANDEX_LLM_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEX_LLM_TIMEOUT_SECONDS=20
YANDEX_LLM_MAX_TOKENS=900
YANDEX_LLM_TEMPERATURE=0.1
LLM_EDITOR_DIGEST_ENABLED=true
LLM_EDITOR_BREAKING_ENABLED=true
LLM_EDITOR_DAILY_REQUEST_LIMIT=60
LLM_EDITOR_DAILY_CHAR_LIMIT=150000
LLM_EDITOR_MAX_DIGEST_ITEMS=14
LLM_EDITOR_MAX_BREAKING_ITEMS=10
LLM_EDITOR_MAX_SUMMARY_CHARS=240
LLM_EDITOR_BREAKING_BUFFER_SECONDS=600
LLM_EDITOR_BREAKING_MIN_INTERVAL_SECONDS=600
LLM_EDITOR_BREAKING_FALLBACK_AFTER_SECONDS=3600

# Optional fallback: improves Russian translations without GPT/OpenAI.
# DeepL API Free key, if you decide to use it later.
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

STATE_DIR=state
LOG_DIR=logs
STATUS_FILE=state/status.json
BREAKING_INTERVAL_SECONDS=120
HEARTBEAT_HOST=127.0.0.1
HEARTBEAT_PORT=8000
HEARTBEAT_TOKEN=
HEARTBEAT_MAIN_STALE_SECONDS=180
HEARTBEAT_BREAKING_STALE_SECONDS=420
HEARTBEAT_MATCHDAY_STALE_SECONDS=600
HEARTBEAT_LIVE_STALE_SECONDS=900
PREFLIGHT_STATUS_TTL_SECONDS=1800

# HTTP and Telegram safety limits.
HTTP_USER_AGENT="CoffeeBot/1.0 (+https://t.me/slivochniyfootball)"
RSS_TIMEOUT_SECONDS=15
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MESSAGE_LIMIT=3900

# Telegram hashtags. Values can be separated by spaces or commas.
# Keep values quoted when they start with #.
POST_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками"
DIGEST_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #Дайджест"
BREAKING_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #СливочнаяМолния"
HERE_WE_GO_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #HereWeGo"
MATCHDAY_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #МатчДень"
LIVE_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #Live #МатчДень"
WEEKLY_RECAP_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #ИтогиНедели"

# Digest freshness, schedule, ranking and formatting.
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_MORNING_TIME=09:00
DIGEST_DAY_TIME=15:00
DIGEST_EVENING_TIME=21:00
DIGEST_MISSED_CATCHUP_ENABLED=true
DIGEST_MISSED_GRACE_MINUTES=30
DIGEST_LIMIT=10
DIGEST_MIN_ITEMS_TO_POST=3
DIGEST_SHORT_FORMAT_THRESHOLD=6
DIGEST_ENTRY_SCAN_LIMIT=5
DIGEST_DEFAULT_LOOKBACK_HOURS=8
DIGEST_MORNING_LOOKBACK_HOURS=14
DIGEST_DAY_LOOKBACK_HOURS=8
DIGEST_EVENING_LOOKBACK_HOURS=8
DIGEST_NIGHT_LOOKBACK_HOURS=8
DIGEST_INCLUDE_UNDATED=false
DIGEST_DEDUPE_ENABLED=true
DIGEST_PRIORITY_SORT_ENABLED=true
DIGEST_SHOW_RELATED_SOURCES=true
# 0-100. Higher means stricter duplicate grouping.
DIGEST_DEDUPE_SIMILARITY=42
DIGEST_PREFLIGHT_ENABLED=true
DIGEST_PREFLIGHT_MINUTES=5
DIGEST_PREFLIGHT_WARN_MIN_CANDIDATES=6
BREAKING_PREFLIGHT_PENDING_WARN=10

# On the scheduled draw day, a trusted story with Real Madrid's Champions League opponents
# is treated as a one-time special breaking post.
UCL_DRAW_ALERT_ENABLED=true
UCL_DRAW_DATE=2026-08-27

# Weekly editorial recap and persistent transfer state.
WEEKLY_RECAP_ENABLED=true
WEEKLY_RECAP_DAY=sunday
WEEKLY_RECAP_TIME=12:00
WEEKLY_RECAP_TIMEZONE=Europe/Moscow
WEEKLY_RECAP_DAYS=7
WEEKLY_RECAP_LIMIT=8
WEEKLY_RECAP_MIN_ITEMS=3
WEEKLY_RECAP_RESPECT_MATCHDAY_BLOCK=true
TRANSFER_TRACKER_ENABLED=true
# Keep false: the tracker feeds the weekly recap and does not create duplicate market posts.
TRANSFER_TRACKER_POST_UPDATES=false
STORY_LIFECYCLE_ENABLED=true

# Visual editorial formats. The daily cover uses the actual AS front page and
# history posts use the real archival photo from their source. Both skip matchdays.
EDITORIAL_COVER_ENABLED=true
EDITORIAL_COVER_TIME=11:30
EDITORIAL_COVER_TIMEZONE=Europe/Moscow
EDITORIAL_COVER_RESPECT_MATCHDAY_BLOCK=true
EDITORIAL_COVER_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #ОбложкаДня"
HISTORY_ENABLED=true
HISTORY_TIME=10:30
HISTORY_TIMEZONE=Europe/Moscow
HISTORY_EVENTS_FILE=config/history_events.json
HISTORY_RESPECT_MATCHDAY_BLOCK=true
HISTORY_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #ДеньВИстории"

# A non-official breaking item needs corroboration from another independent source.
# Official Real Madrid sources bypass this wait.
BREAKING_CONFIRMATION_ENABLED=true
BREAKING_CONFIRMATION_MIN_SOURCES=2
BREAKING_CONFIRMATION_TTL_MINUTES=90

# Fabrizio Romano's official Telegram channel. Only direct Real Madrid "Here we go"
# transfer confirmations use this route, bypassing the normal two-source wait.
HERE_WE_GO_ENABLED=true
HERE_WE_GO_TELEGRAM_URL=https://t.me/s/fabrizioromanotg
HERE_WE_GO_ENTRY_SCAN_LIMIT=12
HERE_WE_GO_MAX_AGE_MINUTES=180

# Daily refresh writes only confirmed fixture time/id data from API-FOOTBALL.
# Without API_FOOTBALL_KEY it stays in waiting mode and does not alter the calendar.
CALENDAR_REFRESH_ENABLED=true
CALENDAR_REFRESH_TIME=06:30
CALENDAR_REFRESH_TIMEZONE=Europe/Moscow
CALENDAR_REFRESH_SEASON=2026

# Internal server-side report. It never posts to Telegram.
EDITORIAL_REPORT_ENABLED=true
EDITORIAL_REPORT_DAY=sunday
EDITORIAL_REPORT_TIME=12:20
EDITORIAL_REPORT_TIMEZONE=Europe/Moscow

# Optional X/Twitter RSS bridge. Leave all bridge settings empty to keep X disabled.
# Free Nitter mirrors can be listed here. The bot switches to the next one if a
# mirror returns an error, captcha page, empty feed, or an RSS allowlist notice.
# X_NITTER_INSTANCES=https://nitter.poast.org,https://another-working-nitter.example
# A legacy RSS bridge still works too:
# X_RSS_BASE_URL=https://rsshub.app/twitter/user/{handle}
X_RSS_BASE_URL=
X_NITTER_INSTANCES=
X_RSS_CACHE_SECONDS=300
X_RSS_BREAKING_ENTRY_SCAN_LIMIT=6
X_RSS_HANDLES=realmadrid,realmadriden,MadridXtra,FabrizioRomano,MarioCortegana,AranchaMOBILE,melchorcope,JLSanchez78,Ramon_AlvarezMM,GuillermoRai_

# Matchday mode, text live scaffolding and automatic live events.
MATCHDAY_ENABLED=true
MATCH_SCHEDULE_FILE=config/matches.json
MATCHDAY_BLOCK_BEFORE_HOURS=3
MATCHDAY_BLOCK_AFTER_HOURS=2
MATCHDAY_BLOCK_ALL_DAY=false
MATCHDAY_PREVIEW_MINUTES=60
MATCHDAY_DAY_BEFORE_MINUTES=1440
MATCHDAY_HALFTIME_MINUTES=50
MATCHDAY_FULLTIME_MINUTES=125
MATCHDAY_POST_TOLERANCE_MINUTES=20
MATCHDAY_POLL_SECONDS=60
MATCHDAY_LIVE_ENABLED=false
MATCHDAY_LIVE_PROVIDER=api-football
MATCHDAY_LIVE_POLL_SECONDS=180
MATCHDAY_LIVE_BEFORE_MINUTES=15
MATCHDAY_LIVE_AFTER_MINUTES=30
MATCHDAY_LIVE_EVENT_TYPES=Goal,Card,subst,Var
MATCHDAY_LINEUP_ENABLED=true
MATCHDAY_LINEUP_BEFORE_MINUTES=90
MATCHDAY_RESULT_ENABLED=true
# The poll is sent only after a verified final result with confirmed player data.
MATCHDAY_POSTMATCH_POLL_ENABLED=true
MATCHDAY_POSTMATCH_POLL_QUESTION="Кого назовёте игроком матча?"

# Visual identity: branded news covers and match cards with cached club badges.
VISUAL_CARDS_ENABLED=true
VISUAL_NEWS_CARDS_ENABLED=true
VISUAL_MATCH_CARDS_ENABLED=true
VISUAL_X_POST_CARDS_ENABLED=true
CLUB_BADGE_LOOKUP_URL=https://www.thesportsdb.com/api/v1/json/3/searchteams.php
CLUB_BADGE_LOOKUP_TIMEOUT_SECONDS=10

# API-FOOTBALL / API-SPORTS. Defaults cover Real Madrid in La Liga and Champions League.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TEAM_ID=541
API_FOOTBALL_LEAGUE_IDS=140,2
API_FOOTBALL_REQUEST_TIMEOUT_SECONDS=10

# Sources that repeatedly fail editorial filters are downranked after enough data.
SOURCE_QUALITY_AUTOPILOT_ENABLED=true
SOURCE_QUALITY_BACKUP_MIN_CANDIDATES=45
SOURCE_QUALITY_BACKUP_QUARANTINE_RATE=0.60
# Keep hard blocking opt-in until the source history grows further.
SOURCE_QUALITY_HARD_BLOCK_ENABLED=false
SOURCE_QUALITY_HARD_BLOCK_MIN_CANDIDATES=80
SOURCE_QUALITY_HARD_BLOCK_QUARANTINE_RATE=0.78

# Weekly calendar of the next fixtures. Date-only fixtures are labelled as pending time.
WEEK_AHEAD_ENABLED=true
WEEK_AHEAD_DAY=monday
WEEK_AHEAD_TIME=11:00
WEEK_AHEAD_TIMEZONE=Europe/Moscow
WEEK_AHEAD_DAYS=8
WEEK_AHEAD_HASHTAGS="#RealMadrid #HalaMadrid #КофеСоСливками #Календарь"
